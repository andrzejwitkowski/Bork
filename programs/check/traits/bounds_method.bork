trait Show {
    fun show(): String
}
class Circle {
    r: f64
}
class Square {
    s: f64
}
class Box<T> {
    v: T
}
impl Show for Circle {
    fun show(): String { return "circle" }
}
class Holder {
    n: i32
    fun put<T: Show>(t: &T) { }
}
fun main() {
    val h = Holder(1)
    val c = Circle(1.0)
    h.put(&c)
}
