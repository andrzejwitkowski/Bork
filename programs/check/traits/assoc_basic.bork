trait Container {
    type Item
    fun get(): Self::Item
}
class IntBox {
    v: i32
}
class Named {
    n: String
}
impl Container for IntBox {
    type Item = i32
    fun get(): i32 { return this.v }
}
impl Container for Named {
    type Item = String
    fun get(): Self::Item { return this.n }
}
fun first<T: Container>(c: &T): T::Item {
    return c.get()
}
fun main() {
    val b = IntBox(3)
    val x: i32 = first(&b)
    val s = Named("a")
    val y: String = first(&s)
    val z = b.get() + 1
}
