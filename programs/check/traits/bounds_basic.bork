trait Show {
    fun show(): String
}
class Circle {
    r: f64
}
class Square {
    s: f64
}
class Box<T> {
    v: T
}
impl Show for Circle {
    fun show(): String { return "circle" }
}
impl<T: Show> Show for Box<T> {
    fun show(): String { return "box" }
}
fun need<T: Show>(t: &T) { }
fun pass<T: Show>(t: &T) { need(&t) }
fun main() {
    val c = Circle(1.0)
    need(&c)
    val b = Box(Circle(2.0))
    need(&b)
    pass(&b)
    need::<Circle>(&c)
}
