// exit: 6
// return move a on each branch
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = concat("ZZZZZZ", "ZZZ")
    val b = concat("YYYYYY", "YYY")
    val p = P(k)
    val q = P(k + 1)
    return a.length + b.length + p.n + q.n
}
fun spin() {
    var i = 0
    while (i < 300) {
        churn(i)
        i = i + 1
    }
}
fun make(flag: bool): A {
    val a = A(P(5))
    val b = A(P(6))
    if (flag) {
        return move a
    }
    return move b
}
fun main(): i32 {
    val r = make(false)
    spin()
    return r.x.n
}
