// exit: 9
// move into a call argument and back out as the result
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = concat("ZZZZZZ", "ZZZ")
    val b = concat("YYYYYY", "YYY")
    val p = P(k)
    val q = P(k + 1)
    return a.length + b.length + p.n + q.n
}
fun spin() {
    var i = 0
    while (i < 300) {
        churn(i)
        i = i + 1
    }
}
fun take(a: A): A { return a }
fun main(): i32 {
    val a = A(P(9))
    val b = take(move a)
    spin()
    return b.x.n
}
