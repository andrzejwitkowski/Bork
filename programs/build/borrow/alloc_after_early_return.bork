// exit: 0
// stdout: 1200000\n1\n
// Regression: a String allocated after an early `return` used to panic codegen ("function bodies
// always have an open arena").
fun build(a: &[i32; 8], n: i32): i32 {
    if (n > 3) {
        return 9
    }
    val s = "abcdef"
    val t = s
    return t.length
}

fun main(): i32 {
    var a: [i32; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    val r = a[0..8]
    var total = 0
    var rep = 0
    while (rep < 200000) {
        total = total + build(&a, 1)
        rep = rep + 1
    }
    println(total)
    println(r[0])
    return 0
}
