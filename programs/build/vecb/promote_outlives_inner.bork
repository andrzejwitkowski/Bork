// exit: 15
// A `VecB` built in an inner block is promoted into the outer var, which owns a copy (the buffer lives in outer's arena).
fun main(): i32 {
    var outer: VecB<i32> = vecBNew()
    {
        var inner: VecB<i32> = vecBNew()
        inner.push(1)
        inner.push(2)
        inner.push(3)
        inner.push(4)
        inner.push(5)
        outer = promote inner
    }
    // The inner block's arena is gone, so reading outer proves the copy lives in outer's arena.
    var total = 0
    var j = 0
    while (j < outer.len()) {
        total = total + outer.get(j)
        j = j + 1
    }
    return total
}
