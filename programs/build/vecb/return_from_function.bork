// A `VecB` returned from a function outlives the callee's arena; pushing after the return grows in the caller's arena.
fun build(): VecB<i32> {
    var v: VecB<i32> = vecBNew()
    v.push(1)
    v.push(2)
    v.push(3)
    return v
}
fun main(): i32 {
    var v = build()
    v.push(4)
    v.push(5)
    v.push(6)
    var total = 0
    var j = 0
    while (j < v.len()) {
        total = total + v.get(j)
        j = j + 1
    }
    return total
}
