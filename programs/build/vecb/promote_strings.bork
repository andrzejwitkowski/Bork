// exit: 6
// stdout: hello\n
// Promoting a `VecB<String>` copies each String into the outer vector's arena: the inner block's arena is gone when they are read.
fun main(): i32 {
    var outer: VecB<String> = vecBNew()
    {
        var inner: VecB<String> = vecBNew()
        inner.push(concat("hel", "lo"))
        inner.push("x")
        outer = promote inner
    }
    println(outer.get(0))
    return outer.get(0).length + outer.len() - 1
}
