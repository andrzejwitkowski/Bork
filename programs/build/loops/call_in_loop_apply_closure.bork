// exit: 0
// stdout: 15\n
// WHAT THIS TESTS
// A loop-bound closure that a callee only calls (`apply(f, 0)`) and that never leaves the iteration: it stays in the
// iteration region instead of piling up in the result sink (#338).
fun make(n: i32): (i32) -> i32 {
    return move (n) { x -> x + n }
}
fun apply(f: (i32) -> i32, x: i32): i32 {
    return f(x)
}
fun total(): i32 {
    var i = 0
    var sum = 0
    while (i < 5) {
        val f = make(i)
        sum = sum + apply(f, 1)
        i = i + 1
    }
    return sum
}
fun main(): i32 {
    println(total())
    return 0
}
