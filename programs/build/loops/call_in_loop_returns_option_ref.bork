// exit: 0
// stdout: 5\n
// WHAT THIS TESTS
// A function with a result sink calls another that returns `Option<Ref<Node>>` inside a loop and returns the found
// handle: the call result must outlive the loop iteration.
class Node {
    n: i32
}
fun pick(v: &Vec<Ref<Node>>, i: i32): Option<Ref<Node>> {
    if (i >= v.len()) { return None }
    return Some(v.get(i))
}
fun find(v: &Vec<Ref<Node>>): Option<Ref<Node>> {
    var i = 0
    while (true) {
        val p = pick(&v, i)
        when (p) {
            Some(r) => { if val (x = r) { if (x.n == 5) { return Some(r) } } }
            None => { return None }
        }
        i = i + 1
    }
    return None
}
fun main(): i32 {
    var v = Vec::<Ref<Node>>()
    v.push(Node(1))
    v.push(Node(5))
    val found = find(&v)
    when (found) {
        Some(r) => { if val (x = r) { println(x.n) } }
        None => { println(0) }
    }
    return 0
}
