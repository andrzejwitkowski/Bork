// exit: 0
// WHAT THIS TESTS
// A generic tree node `Node<T>` whose children are a `Vec<Ref<Node<T>>>`, used in two regions:
//   - children created in an OUTER block than the parent's arena are held STRONGLY by the parent;
//   - children created in an INNER (newer) block are held WEAKLY (back-edges), and a `Vec<Ref<..>>` of
//     them promoted into an outer arena flips those slots to strong ("rehome").
// strongCount / weakCount are read as differences from a baseline, never as absolute values.
// The exit code is the number of the LAST failed check; 0 means all passed.
class Node<T> {
    value: T
    kids: Vec<Ref<Node<T>>>
}

fun main(): i32 {
    var code = 0
    val leaf = Node(2, Vec<Ref<Node<i32>>>())
    val leaf_ref: Ref<Node<i32>> = leaf
    val s0 = strongCount(leaf_ref)
    val w0 = weakCount(leaf_ref)

    // Parent in the same arena as `leaf`'s arena or newer: the child edge is classified by arena age.
    var parent = Node(1, Vec<Ref<Node<i32>>>())
    parent.kids.push(leaf_ref)
    // Check 1: exactly one slot was added, either strong or weak, never both.
    if (strongCount(leaf_ref) + weakCount(leaf_ref) != s0 + w0 + 1) { code = 1 }

    var held = Vec<Ref<Node<i32>>>()
    {
        val inner = Node(3, Vec<Ref<Node<i32>>>())
        val inner_ref: Ref<Node<i32>> = inner
        val is0 = strongCount(inner_ref)
        val iw0 = weakCount(inner_ref)
        var staging = Vec<Ref<Node<i32>>>()
        staging.push(inner_ref)
        // Check 2: a slot in the SAME arena as its target adds one strong count and no weak one.
        if (strongCount(inner_ref) != is0 + 1) { code = 2 }
        if (weakCount(inner_ref) != iw0) { code = 2 }
        held = promote staging
        // Check 3: promoting into the OUTER arena rehomes the slot; the copy is held from an older
        // arena, so the target is kept alive by it (total slots on the target grew by one).
        if (strongCount(inner_ref) + weakCount(inner_ref) != is0 + iw0 + 2) { code = 3 }
    }
    // Check 4: the promoted vector still holds a live node.
    var total = 0
    var i = 0
    while (i < held.len()) {
        val item = held.get(i)
        if val node = item {
            total = total + node.value
        }
        i = i + 1
    }
    if (total != 3) { code = 4 }
    // Check 5: the leaf's counts returned to baseline-plus-one after nothing else touched them.
    if (strongCount(leaf_ref) + weakCount(leaf_ref) != s0 + w0 + 1) { code = 5 }
    return code
}
