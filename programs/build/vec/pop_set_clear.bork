// exit: 31
// set overwrites, pop returns the last element or None, clear empties.
fun main(): i32 {
    var v = Vec<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v[0] = 10
    v.set(1, 20)
    var out = 0
    val last = v.pop() ?: 0
    out = out + last + v[1] + v[0] - 6
    v.clear()
    val none = v.pop() ?: 4
    return out + v.len() + none
}
