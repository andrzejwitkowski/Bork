// exit: 30
// A move closure capturing a Ref to an object made in a loop body keeps that object alive once pushed into an outer Vec.
class Node { id: i32 }
fun main(): i32 {
    var v = Vec::<() -> i32>()
    var i = 0
    while (i < 3) {
        val k = i + 10
        val s = "ab"
        val r: Ref<Node> = Node(i)
        v.push(move (k, s, r) { -> k + s.length + if val n = r { n.id } else { 0 } })
        i = i + 1
    }
    val f = v.get(2)
    val g = v.get(1)
    return f() + g()
}
