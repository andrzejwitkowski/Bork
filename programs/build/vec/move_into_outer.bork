// exit: 3
// `outer = move inner` copies like `promote`; a shorter source than the target's capacity reuses the target's buffer.
fun main(): i32 {
    var outer: Vec<i32> = vecWithCapacity(8)
    outer.push(9)
    {
        var inner: Vec<i32> = vecNew()
        inner.push(1)
        inner.push(2)
        inner.push(3)
        outer = move inner
    }
    if (outer.capacity() != 8) { return 100 }
    return outer.len()
}
