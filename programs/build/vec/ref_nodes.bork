// exit: 12
// Six pushes grow the buffer once (4 -> 8); the Refs must survive the move of the buffer.
// Node ids are 1..6 (the loop pushes Node(i + 1)).
class Node {
    id: i32
}

fun main(): i32 {
    var v = Vec<Ref<Node>>()
    var i = 0
    while (i < 6) {
        v.push(Node(i + 1))
        i = i + 1
    }
    var out = 0
    val last = v.get(5) // Ref to Node(6)
    val first = v.get(0) // Ref to Node(1)
    if val n = last {
        out = n.id // 6
    }
    if val m = first {
        out = out + m.id // 6 + 1 = 7
    }
    // 7 + v.len() (6) - 1 = 12
    return out + v.len() - 1
}
