// exit: 7
// A promoted closure that captures a class object keeps the object alive after the inner arena ends.
class Node { id: i32 }
fun main(): i32 {
    var outer = Vec::<() -> i32>()
    {
        var inner = Vec::<() -> i32>()
        val n = Node(7)
        inner.push(move (n) { -> n.id })
        outer = promote inner
    }
    val f = outer.get(0)
    return f()
}
