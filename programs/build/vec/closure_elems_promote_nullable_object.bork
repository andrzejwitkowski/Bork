// exit: 7
// A promoted closure that captures a `Node?` holding Some keeps the object alive.
class Node { id: i32 }
fun main(): i32 {
    var outer = Vec::<() -> i32>()
    {
        var inner = Vec::<() -> i32>()
        val n: Node? = Some(Node(7))
        inner.push(move (n) { -> if val x = n { x.id } else { 0 } })
        outer = promote inner
    }
    val f = outer.get(0)
    return f()
}
