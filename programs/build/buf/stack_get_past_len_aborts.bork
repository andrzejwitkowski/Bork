// exit: 1
// `get` past `len()` aborts even though the slot is inside the buffer (cap 4 after one push): Stack checks `i < n`
// itself, not just Buf's capacity check. The harness reports the SIGABRT as exit 1; without the abort main returns 0.
fun main(): i32 {
    val s: Stack<i32> = newStack()
    s.push(1)
    val x = s.get(1)
    return 0
}
