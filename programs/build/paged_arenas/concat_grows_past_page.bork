    val a = concat("0123456789", "0123456789")
    val b = concat(a, a)
    val c = concat(b, b)
    val d = concat(c, c)
    val e = concat(d, d)
    val f = concat(e, e)
    val g = concat(f, f)
    val h = concat(g, g)
