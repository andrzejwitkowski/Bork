// exit: 0
// stdout: 1\n
// A local object stored in a `return` inside a `when` arm (was a silent use-after-free).
class P { n: i32 }
class A { x: P }
enum K { X, Y }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    return a.x.n + b.x.n
}
fun make(f: bool): A {
    val p = P(1)
    val k = if (f) { K.X } else { K.Y }
    when k {
        X => { return A(p) }
        Y => { return A(P(2)) }
    }
}
fun main(): i32 {
    val r = make(true)
    var i = 0
    while (i < 100) {
        churn(i + 7000)
        i = i + 1
    }
    println(r.x.n)
    return 0
}
