// exit: 0
// stdout: 1\n2\n3\n42\n
// `val a = A(x, y, z); return a` is the same as `return A(x, y, z)`: the fields live in the result arena.
class P { n: i32 }
class A {
    x: P
    y: P
    z: P
}
class Wrap { a: A }

fun make(): A {
    val x = P(1)
    val y = P(2)
    val z = P(3)
    val a = A(x, y, z)
    return a
}

fun makeNested(): Wrap {
    val inner = P(42)
    val a = A(inner, P(0), P(0))
    val w = Wrap(a)
    return w
}

fun churn(k: i32): i32 {
    val a = A(P(k), P(k + 1), P(k + 2))
    val b = A(P(k + 3), P(k + 4), P(k + 5))
    return a.x.n + b.z.n
}

fun main(): i32 {
    val r = make()
    val w = makeNested()
    var i = 0
    while (i < 100) {
        churn(i)
        i = i + 1
    }
    println(r.x.n)
    println(r.y.n)
    println(r.z.n)
    println(w.a.x.n)
    return 0
}
