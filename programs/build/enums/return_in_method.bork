// exit: 0
// stdout: 7\n8\n
// The same rules inside a class method.
class P { n: i32 }
class A { x: P }
class F {
    k: i32
    fun make(): A {
        val p = P(7)
        return A(p)
    }
    fun pick(flag: bool): A {
        val p = P(8)
        if (flag) {
            return A(p)
        }
        return A(P(9))
    }
}
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    return a.x.n + b.x.n
}
fun main(): i32 {
    val f = F(0)
    val r = f.make()
    val s = f.pick(true)
    var i = 0
    while (i < 100) {
        churn(i + 7000)
        i = i + 1
    }
    println(r.x.n)
    println(s.x.n)
    return 0
}
