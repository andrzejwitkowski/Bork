// exit: 0
// stdout: 42\n
class N { n: i32 }
class Box { n: N }
fun churn(k: i32): i32 {
    val a = Box(N(k))
    val b = Box(N(k + 1))
    return k
}
fun make(flag: bool): Box {
    val local = Box(N(42))
    if (flag) {
        return Box(local.n)
    }
    return Box(N(1))
}
fun main(): i32 {
    val r = make(true)
    var i = 0
    while (i < 100) {
        churn(i + 7000)
        i = i + 1
    }
    println(r.n.n)
    return 0
}
