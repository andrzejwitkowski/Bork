// exit: 0
// stdout: 1\n
// `return if (..) { A(p) } else { .. }`: the local `p` stored in the value of the `if` is hoisted.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}

fun make(flag: bool): A {
    val p = P(1)
    return if (flag) { A(p) } else { A(P(2)) }
}
fun main(): i32 {
    val r = make(true)
    spin()
    println(r.x.n)
    return 0
}
