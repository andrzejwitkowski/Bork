// exit: 0
// stdout: 3\n
// `return if (..) { a } else { .. }` returns a local object by name from a value `if`.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}

fun make(flag: bool): A {
    val a = A(P(3))
    return if (flag) { a } else { A(P(4)) }
}
fun main(): i32 {
    val r = make(true)
    spin()
    println(r.x.n)
    return 0
}
