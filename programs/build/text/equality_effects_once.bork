// exit: 2
class Counter {
    calls: i32

    fun next(): String {
        calls = calls + 1
        if (calls == 1) { return "a" }
        return "b"
    }
}

fun main(): i32 {
    val counter = Counter(0)
    if (counter.next() == counter.next()) {
        return 0
    }
    return counter.calls
}
