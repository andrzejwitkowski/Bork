// exit: 0
// stdout: 33\n
// Return inside an if val branch.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}

fun make(o: Ref<P>): RA {
    val extra: Ref<P> = P(33)
    if val p = o {
        return RA(extra)
    }
    return RA(P(0))
}
fun main(): i32 {
    val src: Ref<P> = P(1)
    val a = make(src)
    spin()
    show(&a)
    return 0
}
