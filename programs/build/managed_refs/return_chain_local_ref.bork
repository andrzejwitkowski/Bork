// exit: 0
// stdout: 84\n
// Local Ref -> RA -> Outer through two locals, returned by name.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}
fun make(): Outer {
    val p: Ref<P> = P(84)
    val r = RA(p)
    val o = Outer(r)
    return o
}
fun main(): i32 {
    val o = make()
    spin()
    val r = o.r
    show(&r)
    return 0
}
