// exit: 0
// stdout: 206\n
// A Vec of Refs filled in a loop and returned inside an object (50+51+52+53).
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}

fun make(): Bag {
    var v = Vec<Ref<P>>()
    var i = 0
    while (i < 4) {
        v.push(P(i + 50))
        i = i + 1
    }
    return Bag(v)
}
fun main(): i32 {
    val b = make()
    spin()
    var t = 0
    var j = 0
    while (j < 4) {
        val got = b.items.get(j)
        if val p = got { t = t + p.n }
        j = j + 1
    }
    println(t)
    return 0
}
