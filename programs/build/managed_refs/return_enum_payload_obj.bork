// exit: 0
// stdout: 82\n
// An enum whose payload is an object holding a Ref.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}
enum E { Has(r: RA), Empty }
fun make(): E { return E.Has(RA(P(82))) }
fun main(): i32 {
    val e = make()
    spin()
    when e {
        Has(r) => { show(&r) }
        Empty => { println(0) }
    }
    return 0
}
