// exit: 0
// stdout: 15\n
// Return from two nested for loops and an if.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}

fun find(): RA {
    val keep: Ref<P> = P(15)
    for (i in 0..4) {
        for (j in 0..4) {
            if (i == 2) {
                if (j == 3) {
                    return RA(keep)
                }
            }
        }
    }
    return RA(P(0))
}
fun main(): i32 {
    val a = find()
    spin()
    show(&a)
    return 0
}
