// exit: 0
// stdout: 11\n40\n
// A method returns an object holding a Ref: a field of this, and a fresh one.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}

class Holder {
    keep: Ref<P>
    fun get(): RA { return RA(keep) }
    fun fresh(): RA { return RA(P(40)) }
}
fun main(): i32 {
    val h = Holder(P(11))
    val a = h.get()
    val b = h.fresh()
    spin()
    show(&a)
    show(&b)
    return 0
}
