// exit: 42
// Cache owns strong edges to root/hot; child.parent is weak because it points
// back to the older node arena. The nested scope drops cache and all nodes.
class Node {
    id: i32
    value: i32
    parent: Ref<Node>
    child: Ref<Node>
}

class CacheManager {
    root: Ref<Node>
    hot: Ref<Node>
}

fun main(): i32 {
    var answer = 0
    {
        val cache = CacheManager(None, None)
        val root = Node(1, 10, None, None)
        val child = Node(2, 20, root, None)
        root.child = child
        cache.root = root
        cache.hot = child
        val cache_ref: Ref<CacheManager> = cache

        if val manager = cache_ref {
            if val root_live = manager.root {
                if val child_live = root_live.child {
                    if val parent = child_live.parent {
                        if val hot = manager.hot {
                            answer = root_live.id + child_live.value + parent.id + hot.value
                        }
                    }
                }
            }
        }
    }
    return answer
}
