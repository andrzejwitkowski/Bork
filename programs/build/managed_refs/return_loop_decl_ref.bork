// exit: 0
// stdout: 23\n
// A Ref declared in the loop body is fine: the Ref keeps its target alive.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}

fun find(limit: i32): RA {
    var i = 0
    while (i < limit) {
        val p: Ref<P> = P(i + 20)
        if (i == 3) {
            return RA(p)
        }
        i = i + 1
    }
    return RA(P(0))
}
fun main(): i32 {
    val a = find(10)
    spin()
    show(&a)
    return 0
}
