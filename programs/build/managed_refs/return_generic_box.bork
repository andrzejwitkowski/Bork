// exit: 0
// stdout: 81\n
// A generic Box<RA> returned.
class P { n: i32 }
class A { x: P }
class RA { x: Ref<P> }
class Outer { r: RA }
class Bag { items: Vec<Ref<P>> }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b = A(P(k + 1))
    val r: Ref<P> = P(k + 2)
    val c = RA(P(k + 3))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(r: &RA) {
    if val v = r.x { println(v.n) }
}
class Box<T> { v: T }
fun make(): Box<RA> { return Box(RA(P(81))) }
fun main(): i32 {
    val b = make()
    spin()
    val r = b.v
    show(&r)
    return 0
}
