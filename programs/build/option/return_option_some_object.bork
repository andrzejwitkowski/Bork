// exit: 0
// stdout: 2\n
// `return Some(A(..))`: an Option of a fresh object is built in the result arena.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(o: A?) {
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
}

fun make(): A? { return Some(A(P(2))) }
fun main(): i32 {
    val o = make()
    spin()
    show(o)
    return 0
}
