// exit: 0
// stdout: 14\n
// An Option of an object holding a Ref.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(o: A?) {
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
}
class RA { x: Ref<P> }
fun showRA(o: RA?) {
    when o {
        Some(r) => { if val v = r.x { println(v.n) } }
        None => { println(0 - 1) }
    }
}
fun make(): RA? { return Some(RA(P(14))) }
fun main(): i32 {
    val o = make()
    spin()
    showRA(o)
    return 0
}
