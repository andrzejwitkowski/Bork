// exit: 0
// stdout: 31\n
// `outer = Some(A(..))` from an inner block: the object is built in the outer variable arena.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun main(): i32 {
    var o: A? = None
    {
        o = Some(A(P(31)))
    }
    spin()
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
    return 0
}
