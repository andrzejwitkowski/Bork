// exit: 0
// stdout: 34\n
// Overwritten from two blocks, with churn in between.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun main(): i32 {
    var o: A? = Some(A(P(1)))
    {
        o = Some(A(P(33)))
    }
    {
        spin()
        o = Some(A(P(34)))
    }
    spin()
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
    return 0
}
