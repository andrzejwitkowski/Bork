// exit: 0
// stdout: 5\n
// Some(object) stored in a field of the returned object.
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun show(o: A?) {
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
}

class Holder { a: A? }
fun make(): Holder { return Holder(Some(A(P(5)))) }
fun main(): i32 {
    val h = make()
    spin()
    show(h.a)
    return 0
}
