// exit: 0
// stdout: 1\n2\n3\n
class P { x: i32 }
impl Eq for P {
    fun eq(other: &P): bool { return this.x == other.x }
}
impl Ord for P {
    fun cmp(other: &P): i32 { return this.x - other.x }
}
fun same<T: Eq>(a: &T, b: &T): bool { return a == b }
fun below<T: Ord>(a: &T, b: &T): bool { return a < b }
fun atLeast<T: Ord>(a: &T, b: &T): bool { return a >= b }
fun main(): i32 {
    val a = P(4)
    val b = P(5)
    if (same(&a, &a)) { println(1) }
    if (below(&a, &b)) { println(2) }
    if (!atLeast(&a, &b)) { println(3) }
    return 0
}
