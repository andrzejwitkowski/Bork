// exit: 0
// stdout: 7\n
trait Other {
    type Item
}
trait Container {
    type Item
    fun get(): Self::Item
}
class Foo {
    v: i32
}
impl Other for Foo {
    type Item = String
}
impl Container for Foo {
    type Item = i32
    fun get(): Self::Item { return this.v }
}
fun first<T: Container>(c: &T): T::Item {
    return c.get()
}
fun main(): i32 {
    val f = Foo(7)
    println(first(&f))
    return 0
}
