// diag: moving class objects is not supported by codegen yet
// `bork check` accepts moving a generic class object out of its region, `bork build` does not.
// The design for moving/promoting class objects is open (#63 keeps the gate); this pins the gate
// so that lifting it later is a deliberate change that updates this program.
class Box<T> {
    v: T
}

fun main() {
    var outer = Box("a")
    {
        val inner = Box("b")
        outer = move inner
    }
}
