// diag: this `move` would leave the object in an arena that is freed before its new owner
// the move runs only on one path, so the declaration cannot be placed in the outer arena
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = concat("ZZZZZZ", "ZZZ")
    val p = P(k)
    val q = P(k + 1)
    return a.length + p.n + q.n
}
fun spin() {
    var i = 0
    while (i < 300) {
        churn(i)
        i = i + 1
    }
}
fun main(): i32 {
    var outer = A(P(1))
    {
        val inner = A(P(42))
        if (true) {
            outer = move inner
        }
    }
    spin()
    return outer.x.n
}
