// diag: this `move` would leave the object in an arena that is freed before its new owner
// a statement between the declaration and the move keeps hoisting from reaching the declaration
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = concat("ZZZZZZ", "ZZZ")
    val p = P(k)
    val q = P(k + 1)
    return a.length + p.n + q.n
}
fun spin() {
    var i = 0
    while (i < 300) {
        churn(i)
        i = i + 1
    }
}
fun main(): i32 {
    var outer = A(P(1))
    {
        val inner = A(P(42))
        val z = 1
        outer = move inner
    }
    spin()
    return outer.x.n
}
