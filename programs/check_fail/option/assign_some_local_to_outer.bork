// diag: is freed before the value that stores it
class P { n: i32 }
class A { x: P }
fun churn(k: i32): i32 {
    val a = A(P(k))
    val b: A? = Some(A(P(k + 1)))
    val c = A(P(k + 2))
    return k
}
fun spin() {
    var i = 0
    while (i < 200) {
        churn(i + 7000)
        i = i + 1
    }
}
fun main(): i32 {
    var o: A? = None
    {
        val n = A(P(32))
        o = Some(move n)
    }
    spin()
    when o {
        Some(a) => { println(a.x.n) }
        None => { println(0 - 1) }
    }
    return 0
}
