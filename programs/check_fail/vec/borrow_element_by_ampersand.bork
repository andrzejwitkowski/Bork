// diag: cannot call `push` on `v` while `e`, a view of one of its elements, is still in use
// at: 8:5
// `&v[i]` views the slot; `push` may reallocate the buffer under it (vec-design, Borrows).
fun main(): i32 {
    var v = Vec::<String>()
    v.push("a")
    val e = &v[0]
    v.push("b")
    return e.length
}
