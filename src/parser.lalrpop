use crate::ast::{
    BindingKind, BinOp, Block, Closure, Expr, Function, Param, Program, Stmt, Type,
};
use lalrpop_util::ParseError;

grammar;

match {
    r"[ \t\r\f]+" => { },
    r"//[^\n\r]*" => { },
    r"([ \t\r\f]*(//[^\n\r]*)?\n)+" => "NL",
} else {
    _
}

BinTier<Op, Next>: Expr = {
    <lhs:BinTier<Op, Next>> <op:Op> <rhs:Next> => Expr::Binary {
        op,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
    },
    <e:Next> => e,
};

Comma<T>: Vec<T> = {
    <mut items:(<T> ",")*> <last:T> => {
        items.push(last);
        items
    },
};

pub Program: Program = {
    => Program { functions: vec![] },
    "NL" => Program { functions: vec![] },
    <functions:FunctionList> => Program { functions },
    "NL" <functions:FunctionList> => Program { functions },
};

FunctionList: Vec<Function> = {
    <function:Function> => vec![function],
    <function:Function> "NL" <rest:FunctionList> => {
        let mut functions = vec![function];
        functions.extend(rest);
        functions
    },
    <function:Function> "NL" => vec![function],
};

Function: Function = {
    "fun" <name:Ident> "(" <params:Comma<Param>?> ")" <ret:ReturnType> <body:Block> => {
        Function {
            name,
            params: params.unwrap_or_default(),
            return_type: ret,
            body,
        }
    },
};

ReturnType: Type = {
    ":" <ty:Type> => ty,
    => Type::Named {
        name: "Unit".into(),
        nullable: false,
    },
};

Param: Param = {
    <name:Ident> ":" <ty:Type> => Param { name, ty },
};

Type: Type = {
    <name:Ident> <q:"?"?> => Type::Named {
        name,
        nullable: q.is_some(),
    },
    "(" <ty:ParenType> => ty,
};

ParenType: Type = {
    ")" "->" <ret:Type> => Type::Func {
        params: vec![],
        ret: Box::new(ret),
        nullable: false,
    },
    <mut types:Comma<Type>> ")" <ret:ParenTypeSuffix> =>? match ret {
        Some(ret) => Ok(Type::Func {
            params: types,
            ret: Box::new(ret),
            nullable: false,
        }),
        None => {
            let inner = types.pop().ok_or(ParseError::User {
                error: "nullable parentheses require one function type",
            })?;
            if !types.is_empty() {
                return Err(ParseError::User {
                    error: "nullable parentheses require one function type",
                });
            }
            match inner {
                Type::Func { params, ret, .. } => Ok(Type::Func {
                    params,
                    ret,
                    nullable: true,
                }),
                Type::Named { .. } => Err(ParseError::User {
                    error: "only function types may be parenthesized for nullability",
                }),
            }
        }
    },
};

ParenTypeSuffix: Option<Type> = {
    "->" <ret:Type> => Some(ret),
    "?" => None,
};

Block: Block = {
    "{" <stmts:BlockBody> "}" => Block { stmts },
};

BlockBody: Vec<Stmt> = {
    => vec![],
    "NL" => vec![],
    <first:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
    "NL" <first:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
};

StmtRest: Vec<Stmt> = {
    => vec![],
    "NL" => vec![],
    "NL" <stmt:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![stmt];
        stmts.extend(rest);
        stmts
    },
};

Stmt: Stmt = {
    <b:Block> => Stmt::Block(b),
    "val" <name:Ident> "=" <value:Expr> => Stmt::VarDecl {
        kind: BindingKind::Val,
        name,
        value,
    },
    "var" <name:Ident> "=" <value:Expr> => Stmt::VarDecl {
        kind: BindingKind::Var,
        name,
        value,
    },
    <name:Ident> "=" <value:Expr> => Stmt::Assign { name, value },
    "for" "(" <name:Ident> "in" <iter:Expr> ")" <body:Block> => Stmt::For {
        name,
        iter,
        body,
    },
    "return" <value:Expr?> => Stmt::Return(value),
    <e:Expr> => Stmt::Expr(e),
};

Expr: Expr = {
    <e:ExprRange> => e,
};

ExprRange = BinTier<RangeOp, ExprCompare>;
ExprCompare = BinTier<CompareOp, ExprAdd>;
ExprAdd = BinTier<AddOp, ExprMul>;
ExprMul = BinTier<MulOp, ExprCall>;

RangeOp: BinOp = { ".." => BinOp::RangeTo };
CompareOp: BinOp = {
    ">" => BinOp::Gt,
    "<" => BinOp::Lt,
    ">=" => BinOp::Ge,
    "<=" => BinOp::Le,
    "==" => BinOp::Eq,
    "!=" => BinOp::Ne,
};
AddOp: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
};
MulOp: BinOp = {
    "*" => BinOp::Mul,
    "/" => BinOp::Div,
};

ExprCall: Expr = {
    <callee:ExprCall> "(" <args:Comma<Expr>?> ")" <trailing:TrailingClosure?> => Expr::Call {
        callee: Box::new(callee),
        args: args.unwrap_or_default(),
        trailing,
    },
    <e:Atom> => e,
};

TrailingClosure: Closure = {
    "{" <params:Comma<Ident>?> "->" <stmts:BlockBody> "}" => Closure {
        params: params.unwrap_or_default(),
        body: Block { stmts },
    },
};

Atom: Expr = {
    <n:Num> => Expr::Int(n),
    <id:Ident> => Expr::Ident(id),
    "(" <e:Expr> ")" => e,
    "if" "(" <cond:Expr> ")" <then_block:Block> <sep:ElseSep> "else" <else_block:Block> => {
        let () = sep;
        Expr::If {
            cond: Box::new(cond),
            then_block,
            else_block,
        }
    },
};

ElseSep: () = {
    => (),
    "NL" => (),
};

Ident: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string(),
};

Num: i64 = {
    r"[0-9]+" =>? <>.parse().map_err(|_| ParseError::User {
        error: "integer literal out of range for i64",
    }),
};
