use crate::ast::{
    unescape_string_literal, BindingKind, BinOp, Block, Closure, Expr, Function, Param, Program,
    Stmt, Type, UnaryOp,
};
use crate::span::{Span, SpannedName};
use lalrpop_util::ParseError;

grammar;

match {
    r"[ \t\r\f]+" => { },
    r"//[^\n\r]*" => { },
    // Fold optional NL/comments before `else` so Ident cannot claim the keyword.
    r"(([ \t\r\f]*(//[^\n\r]*)?\n)+[ \t]*)?else" => "else",
    r"([ \t\r\f]*(//[^\n\r]*)?\n)+" => "NL",
    "if" => "if",
    "fun" => "fun",
    "val" => "val",
    "var" => "var",
    "for" => "for",
    "in" => "in",
    "return" => "return",
    "Some" => "Some",
    "None" => "None",
    "move" => "move",
} else {
    _
}

BinTier<Op, Next>: Expr = {
    <lhs:BinTier<Op, Next>> <op:Op> <rhs:Next> => Expr::Binary {
        op,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
    },
    <e:Next> => e,
};

Comma<T>: Vec<T> = {
    <mut items:(<T> ",")*> <last:T> => {
        items.push(last);
        items
    },
};

pub Program: Program = {
    => Program { functions: vec![] },
    "NL" => Program { functions: vec![] },
    <functions:FunctionList> => Program { functions },
    "NL" <functions:FunctionList> => Program { functions },
};

FunctionList: Vec<Function> = {
    <function:Function> => vec![function],
    <function:Function> "NL" <rest:FunctionList> => {
        let mut functions = vec![function];
        functions.extend(rest);
        functions
    },
    <function:Function> "NL" => vec![function],
};

Function: Function = {
    "fun" <name:Ident> "(" <params:Comma<Param>?> ")" <ret:ReturnType> <body:Block> => {
        Function {
            name,
            params: params.unwrap_or_default(),
            return_type: ret,
            body,
        }
    },
};

ReturnType: Type = {
    ":" <ty:Type> => ty,
    => Type::unit(false),
};

Param: Param = {
    <name:SpannedIdent> ":" <ty:Type> => Param { name, ty },
};

Type: Type = {
    <name:Ident> <q:"?"?> => Type::from_ident(&name, q.is_some()),
    "(" <ty:ParenType> => ty,
};

ParenType: Type = {
    ")" "->" <ret:Type> => Type::Func {
        params: vec![],
        ret: Box::new(ret),
        nullable: false,
    },
    ")" <q:"?"?> => Type::unit(q.is_some()),
    <mut types:Comma<Type>> ")" <ret:ParenTypeSuffix> =>? match ret {
        Some(ret) => Ok(Type::Func {
            params: types,
            ret: Box::new(ret),
            nullable: false,
        }),
        None => {
            let inner = types.pop().ok_or(ParseError::User {
                error: "nullable parentheses require one function type",
            })?;
            if !types.is_empty() {
                return Err(ParseError::User {
                    error: "nullable parentheses require one function type",
                });
            }
            match inner {
                Type::Func { params, ret, .. } => Ok(Type::Func {
                    params,
                    ret,
                    nullable: true,
                }),
                Type::Named { .. } | Type::Primitive { .. } => Err(ParseError::User {
                    error: "only function types may be parenthesized for nullability",
                }),
            }
        }
    },
};

ParenTypeSuffix: Option<Type> = {
    "->" <ret:Type> => Some(ret),
    "?" => None,
};

Block: Block = {
    "{" <stmts:BlockBody> "}" => Block { stmts },
};

BlockBody: Vec<Stmt> = {
    => vec![],
    "NL" => vec![],
    <first:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
    "NL" <first:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
};

StmtRest: Vec<Stmt> = {
    => vec![],
    "NL" => vec![],
    "NL" <stmt:Stmt> <rest:StmtRest> => {
        let mut stmts = vec![stmt];
        stmts.extend(rest);
        stmts
    },
};

Stmt: Stmt = {
    <b:Block> => Stmt::Block(b),
    "move" <captures:("(" <Comma<SpannedIdent>?> ")")?> <body:Block> => Stmt::MoveBlock {
        captures: captures.map(|c| c.unwrap_or_default()),
        body,
    },
    <kind:Binding> <name:SpannedIdent> <ty:(":" <Type>)?> "=" <value:Expr> => Stmt::VarDecl {
        kind,
        name: name.name,
        name_span: name.span,
        ty,
        value,
    },
    <name:SpannedIdent> "=" <value:Expr> => Stmt::Assign {
        name: name.name,
        name_span: name.span,
        value,
    },
    "for" "(" <name:SpannedIdent> "in" <iter:Expr> ")" <body:Block> => Stmt::For {
        name,
        iter,
        body,
    },
    "return" <value:Expr?> => Stmt::Return(value),
    <e:Expr> => Stmt::Expr(e),
};

Binding: BindingKind = {
    "val" => BindingKind::Val,
    "var" => BindingKind::Var,
};

Expr: Expr = {
    <e:ExprElvis> => e,
};

ExprElvis: Expr = {
    <lhs:ExprRange> "?:" <rhs:ExprElvis> => Expr::Binary {
        op: BinOp::Elvis,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
    },
    <e:ExprRange> => e,
};

ExprRange = BinTier<RangeOp, ExprCompare>;
ExprCompare = BinTier<CompareOp, ExprAdd>;
ExprAdd = BinTier<AddOp, ExprMul>;
ExprMul = BinTier<MulOp, ExprSuffix>;

RangeOp: BinOp = { ".." => BinOp::RangeTo };
CompareOp: BinOp = {
    ">" => BinOp::Gt,
    "<" => BinOp::Lt,
    ">=" => BinOp::Ge,
    "<=" => BinOp::Le,
    "==" => BinOp::Eq,
    "!=" => BinOp::Ne,
};
AddOp: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
};
MulOp: BinOp = {
    "*" => BinOp::Mul,
    "/" => BinOp::Div,
};

ExprSuffix: Expr = {
    <callee:ExprSuffix> "(" <args:Comma<Expr>?> ")" <trailing:TrailingClosure?> => Expr::Call {
        callee: Box::new(callee),
        args: args.unwrap_or_default(),
        trailing,
    },
    <receiver:ExprSuffix> <safe:FieldOp> <name:Ident> => Expr::Field {
        receiver: Box::new(receiver),
        name,
        safe,
    },
    <expr:ExprSuffix> "!!" => Expr::Unary {
        op: UnaryOp::NotNullAssert,
        expr: Box::new(expr),
    },
    <e:Atom> => e,
};

FieldOp: bool = {
    "." => false,
    "?." => true,
};

TrailingClosure: Closure = {
    "move" <captures:("(" <Comma<SpannedIdent>?> ")")?> <c:MoveClosureBody> => Closure {
        params: c.0,
        body: c.1,
        is_move: true,
        captures: captures.map(|c| c.unwrap_or_default()),
    },
    "{" <params:Comma<SpannedIdent>?> "->" <stmts:BlockBody> "}" => Closure {
        params: params.unwrap_or_default(),
        body: Block { stmts },
        is_move: false,
        captures: None,
    },
};

MoveClosureBody: (Vec<SpannedName>, Block) = {
    "{" <params:Comma<SpannedIdent>?> "->" <stmts:BlockBody> "}" => (
        params.unwrap_or_default(),
        Block { stmts },
    ),
    "{" <stmts:BlockBody> "}" => (vec![], Block { stmts }),
};

Atom: Expr = {
    <n:Num> => Expr::Int(n),
    <s:StrLit> => Expr::Str(s),
    "None" => Expr::None,
    "Some" "(" <e:Expr> ")" => Expr::Some(Box::new(e)),
    <id:SpannedIdent> => Expr::Ident {
        name: id.name,
        span: id.span,
    },
    "(" <e:Expr> ")" => e,
    "if" "(" <cond:Expr> ")" <then_block:Block> <else_block:ElseClause?> => Expr::If {
        cond: Box::new(cond),
        then_block,
        else_block,
    },
};

ElseClause: Block = {
    "else" <b:Block> => b,
};

SpannedIdent: SpannedName = {
    <start:@L> <name:Ident> <end:@R> => SpannedName::new(name, Span::new(start, end)),
};

Ident: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string(),
};

Num: i64 = {
    r"[0-9]+" =>? <>.parse().map_err(|_| ParseError::User {
        error: "integer literal out of range for i64",
    }),
};

StrLit: String = {
    r#""([^"\\]|\\.)*""# => unescape_string_literal(<>),
};
