use crate::ast::{
    unescape_string_literal, AssignTarget, BindingKind, BinOp, Block, Class, ConstDecl, Enum, Variant, ClassField, ClassMember, Closure,
    ConditionalBinding, ConditionalBindings, Expr, Function, Item, Param, Program, Stmt, Type, TypeParam,
    UnaryOp,
};
use crate::span::{AstId, Span, SpannedName};
use lalrpop_util::ParseError;

grammar;

match {
    r"[ \t\r\f]+" => { },
    r"//[^\n\r]*" => { },
    // Fold optional NL/comments before `else` so Ident cannot claim the keyword.
    r"(([ \t\r\f]*(//[^\n\r]*)?\n)+[ \t]*)?else" => "else",
    r"([ \t\r\f]*(//[^\n\r]*)?\n)+" => "NL",
    "if" => "if",
    "class" => "class",
    "enum" => "enum",
    "const" => "const",
    "this" => "this",
    "when" => "when",
    "fun" => "fun",
    "val" => "val",
    "var" => "var",
    "for" => "for",
    "in" => "in",
    "return" => "return",
    "Some" => "Some",
    "None" => "None",
    "move" => "move",
    "promote" => "promote",
    "::" => "::",
} else {
    _
}

BinTier<Op, Next>: Expr = {
    <start:@L> <lhs:BinTier<Op, Next>> <op:Op> <rhs:Next> <end:@R> => Expr::Binary {
        op,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::new(start, end),
    },
    <e:Next> => e,
};

Comma<T>: Vec<T> = {
    <mut items:(<T> ",")*> <last:T> => {
        items.push(last);
        items
    },
};

pub Program: Program = {
    => Program::from_items(vec![]),
    "NL" => Program::from_items(vec![]),
    <items:ItemList> => Program::from_items(items),
    "NL" <items:ItemList> => Program::from_items(items),
};

ItemList: Vec<Item> = {
    <item:Item> => vec![item],
    <item:Item> "NL" <rest:ItemList> => {
        let mut items = vec![item];
        items.extend(rest);
        items
    },
    <item:Item> "NL" => vec![item],
};

Item: Item = {
    <constant:ConstDecl> => Item::Const(constant),
    <class:ClassDecl> => Item::Class(class),
    <e:EnumDecl> => Item::Enum(e),
    <f:Function> => Item::Fun(f),
};

ConstDecl: ConstDecl = {
    "const" <name:SpannedIdent> ":" <ty:Type> "=" <start:@L> <value:Expr> <end:@R> => ConstDecl {
        name,
        ty,
        value,
        value_span: Span::new(start, end),
    },
};

ClassDecl: Class = {
    "class" <name:Ident> <generics:TypeParams?> "{" <members:ClassBody> "}" => {
        Class::from_members(name, generics.unwrap_or_default(), members)
    },
};

EnumDecl: Enum = {
    "enum" <name:SpannedIdent> <generics:TypeParams?> "{" <variants:EnumBody> "}" => Enum {
        name,
        generics: generics.unwrap_or_default(),
        variants,
    },
};

EnumBody: Vec<Variant> = {
    => vec![],
    "NL" => vec![],
    <items:EnumVariants> EnumSep? => items,
    "NL" <items:EnumVariants> EnumSep? => items,
};

EnumVariants: Vec<Variant> = {
    <variant:EnumVariant> => vec![variant],
    <mut items:EnumVariants> EnumSep <variant:EnumVariant> => {
        items.push(variant);
        items
    },
};

EnumSep: () = {
    "," => (),
    "," "NL" => (),
    "NL" => (),
};

EnumVariant: Variant = {
    <name:SpannedIdent> <fields:("(" <Comma<ClassFieldDecl>> ")")?> => Variant {
        name,
        fields: fields.unwrap_or_default(),
    },
};

ClassBody: Vec<ClassMember> = {
    => vec![],
    "NL" => vec![],
    <first:ClassMember> <rest:ClassMemberRest> => {
        let mut members = vec![first];
        members.extend(rest);
        members
    },
    "NL" <first:ClassMember> <rest:ClassMemberRest> => {
        let mut members = vec![first];
        members.extend(rest);
        members
    },
};

ClassMemberRest: Vec<ClassMember> = {
    => vec![],
    "NL" => vec![],
    "NL" <member:ClassMember> <rest:ClassMemberRest> => {
        let mut members = vec![member];
        members.extend(rest);
        members
    },
};

ClassMember: ClassMember = {
    <field:ClassFieldDecl> => ClassMember::Field(field),
    <method:Function> => ClassMember::Method(method),
};

ClassFieldDecl: ClassField = {
    <name:SpannedIdent> ":" <ty:Type> => ClassField { name, ty },
};

TypeParams: Vec<TypeParam> = {
    "<" <names:Comma<SpannedIdent>> ">" => names.into_iter().map(|name| TypeParam { name }).collect(),
};

TypeArgs: Vec<Type> = {
    "<" <types:Comma<Type>> ">" => types,
};

Function: Function = {
    "fun" <name:SpannedIdent> <generics:TypeParams?> "(" <params:Comma<Param>?> ")" <ret:ReturnType> <body:Block> => {
        Function {
            name: name.name,
            name_span: name.span,
            id: AstId::DUMMY,
            generics: generics.unwrap_or_default(),
            params: params.unwrap_or_default(),
            return_type: ret,
            body,
        }
    },
};

ReturnType: Type = {
    ":" <ty:Type> => ty,
    => Type::unit(false),
};

Param: Param = {
    <kind:Binding> <name:SpannedIdent> ":" <ty:Type> => Param { kind, name, ty },
    <name:SpannedIdent> ":" <ty:Type> => Param { kind: BindingKind::Val, name, ty },
};

Type: Type = {
    "Ref" "<" <inner:Type> ">" => Type::ManagedRef {
        inner: Box::new(inner),
    },
    "Vec" "<" <elem:Type> ">" => Type::Vec {
        elem: Box::new(elem),
    },
    "&" <inner:Type> => Type::Ref {
        inner: Box::new(inner),
        nullable: false,
    },
    "[" <elem:Type> ";" <len:ArrayTypeLen> "]" <q:"?"?> => Type::Array {
        elem: Box::new(elem),
        len,
        nullable: q.is_some(),
    },
    <name:Ident> <q:"?"?> => Type::from_ident(&name, q.is_some()),
    <name:Ident> <args:TypeArgs> <q:"?"?> => Type::Named { name, args, nullable: q.is_some() },
    "(" <ty:ParenType> => ty,
};

ParenType: Type = {
    ")" "->" <ret:Type> => Type::Func {
        params: vec![],
        ret: Box::new(ret),
        nullable: false,
    },
    ")" <q:"?"?> => Type::unit(q.is_some()),
    <mut types:Comma<Type>> ")" <ret:ParenTypeSuffix> =>? match ret {
        Some(ret) => Ok(Type::Func {
            params: types,
            ret: Box::new(ret),
            nullable: false,
        }),
        None => {
            let inner = types.pop().ok_or(ParseError::User {
                error: "nullable parentheses require one function type",
            })?;
            if !types.is_empty() {
                return Err(ParseError::User {
                    error: "nullable parentheses require one function type",
                });
            }
            match inner {
                Type::Func { params, ret, .. } => Ok(Type::Func {
                    params,
                    ret,
                    nullable: true,
                }),
                Type::Named { .. }
                | Type::Primitive { .. }
                | Type::Array { .. }
                | Type::Ref { .. }
                | Type::ManagedRef { .. }
                | Type::Vec { .. } => Err(ParseError::User {
                    error: "only function types may be parenthesized for nullability",
                }),
            }
        }
    },
};

ParenTypeSuffix: Option<Type> = {
    "->" <ret:Type> => Some(ret),
    "?" => None,
};

Block: Block = {
    <start:@L> "{" <stmts:BlockBody> "}" <end:@R> => Block::from_spanned(Span::new(start, end), stmts),
};

BlockBody: Vec<(Stmt, Span)> = {
    => vec![],
    "NL" => vec![],
    <first:SpannedStmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
    "NL" <first:SpannedStmt> <rest:StmtRest> => {
        let mut stmts = vec![first];
        stmts.extend(rest);
        stmts
    },
};

StmtRest: Vec<(Stmt, Span)> = {
    => vec![],
    "NL" => vec![],
    "NL" <stmt:SpannedStmt> <rest:StmtRest> => {
        let mut stmts = vec![stmt];
        stmts.extend(rest);
        stmts
    },
};

SpannedStmt: (Stmt, Span) = {
    <start:@L> <stmt:Stmt> <end:@R> => (stmt, Span::new(start, end)),
};

Stmt: Stmt = {
    <b:Block> => Stmt::Block(b),
    "move" <captures:("(" <Comma<SpannedIdent>?> ")")?> <body:Block> => Stmt::MoveBlock {
        captures: captures.map(|c| c.unwrap_or_default()),
        body,
    },
    <kind:Binding> <name:SpannedIdent> <ty:(":" <Type>)?> "=" <value:Expr> => Stmt::VarDecl {
        kind,
        name: name.name,
        name_span: name.span,
        id: AstId::DUMMY,
        ty,
        value,
    },
    <lhs:Expr> "=" <value:Expr> =>? {
        match lhs {
            Expr::Ident { name, span, .. } => Ok(Stmt::Assign {
                target: AssignTarget::Name {
                    name,
                    name_span: span,
                    id: AstId::DUMMY,
                },
                value,
            }),
            Expr::Index { receiver, index, .. } => match *receiver {
                Expr::Ident { name, span, .. } => Ok(Stmt::Assign {
                    target: AssignTarget::Index {
                        name,
                        name_span: span,
                        id: AstId::DUMMY,
                        index: *index,
                        borrowed: false,
                    },
                    value,
                }),
                Expr::Unary {
                    op: UnaryOp::Borrow,
                    expr,
                    ..
                } => match *expr {
                    Expr::Ident { name, span, .. } => Ok(Stmt::Assign {
                        target: AssignTarget::Index {
                            name,
                            name_span: span,
                            id: AstId::DUMMY,
                            index: *index,
                            borrowed: true,
                        },
                        value,
                    }),
                    _ => Err(ParseError::User {
                        error: "assignment target must be a name, name[index], or name.field",
                    }),
                },
                _ => Err(ParseError::User {
                    error: "assignment target must be a name, name[index], or name.field",
                }),
            },
            Expr::Field {
                receiver,
                name,
                safe: false,
                span,
                ..
            } => Ok(Stmt::Assign {
                target: AssignTarget::Field {
                    receiver: *receiver,
                    name,
                    span,
                    id: AstId::DUMMY,
                },
                value,
            }),
            _ => Err(ParseError::User {
                error: "assignment target must be a name, field, or name[index]",
            }),
        }
    },
    "for" "(" <name:SpannedIdent> "in" <iter:Expr> ")" <body:Block> => Stmt::For {
        name,
        iter,
        body,
    },
    "while" "(" <cond:Expr> ")" <body:Block> => Stmt::While {
        cond,
        body,
    },
    <start:@L> "break" <end:@R> => Stmt::Break {
        span: Span::new(start, end),
    },
    <start:@L> "continue" <end:@R> => Stmt::Continue {
        span: Span::new(start, end),
    },
    "return" <value:Expr?> => Stmt::Return(value),
    <e:Expr> => Stmt::Expr(e),
};

Binding: BindingKind = {
    "val" => BindingKind::Val,
    "var" => BindingKind::Var,
};

Expr: Expr = {
    <e:ExprElvis> => e,
};

ExprElvis: Expr = {
    <start:@L> <lhs:ExprOr> "?:" <rhs:ExprElvis> <end:@R> => Expr::Binary {
        op: BinOp::Elvis,
        lhs: Box::new(lhs),
        rhs: Box::new(rhs),
        span: Span::new(start, end),
    },
    <e:ExprOr> => e,
};

ExprOr = BinTier<OrOp, ExprAnd>;
ExprAnd = BinTier<AndOp, ExprRange>;
ExprRange = BinTier<RangeOp, ExprCompare>;
ExprCompare = BinTier<CompareOp, ExprAdd>;
ExprAdd = BinTier<AddOp, ExprMul>;
ExprMul = BinTier<MulOp, ExprUnary>;

ExprUnary: Expr = {
    <start:@L> "!" <inner:ExprUnary> <end:@R> => Expr::Unary {
        op: UnaryOp::Not,
        expr: Box::new(inner),
        span: Span::new(start, end),
    },
    <start:@L> "&" <inner:ExprUnary> <end:@R> => Expr::Unary {
        op: UnaryOp::Borrow,
        expr: Box::new(inner),
        span: Span::new(start, end),
    },
    <e:ExprSuffix> => e,
};

OrOp: BinOp = { "||" => BinOp::Or };
AndOp: BinOp = { "&&" => BinOp::And };
RangeOp: BinOp = { ".." => BinOp::RangeTo };
CompareOp: BinOp = {
    ">" => BinOp::Gt,
    "<" => BinOp::Lt,
    ">=" => BinOp::Ge,
    "<=" => BinOp::Le,
    "==" => BinOp::Eq,
    "!=" => BinOp::Ne,
};
AddOp: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
};
MulOp: BinOp = {
    "*" => BinOp::Mul,
    "/" => BinOp::Div,
};

ExprSuffix: Expr = {
    <callee:ExprSuffix> "(" <args:Comma<Expr>?> ")" <trailing:TrailingClosure?> => Expr::Call {
        callee: Box::new(callee),
        type_args: Vec::new(),
        args: args.unwrap_or_default(),
        trailing,
    },
    <callee:ExprSuffix> "::" <type_args:TypeArgs> "(" <args:Comma<Expr>?> ")" <trailing:TrailingClosure?> => Expr::Call {
        callee: Box::new(callee),
        type_args,
        args: args.unwrap_or_default(),
        trailing,
    },
    <start:@L> <receiver:ExprSuffix> "[" <lo:ExprCompare> ".." <hi:ExprCompare> "]" <end:@R> => Expr::Slice {
        receiver: Box::new(receiver),
        lo: Box::new(lo),
        hi: Box::new(hi),
        span: Span::new(start, end),
    },
    <start:@L> <receiver:ExprSuffix> "[" <index:ExprCompare> "]" <end:@R> => Expr::Index {
        receiver: Box::new(receiver),
        index: Box::new(index),
        span: Span::new(start, end),
    },
    <start:@L> <receiver:ExprSuffix> <safe:FieldOp> <name:Ident> <end:@R> => Expr::Field {
        receiver: Box::new(receiver),
        name,
        safe,
        span: Span::new(start, end),
        id: AstId::DUMMY,
    },
    <start:@L> <expr:ExprSuffix> "!!" <end:@R> => Expr::Unary {
        op: UnaryOp::NotNullAssert,
        expr: Box::new(expr),
        span: Span::new(start, end),
    },
    <e:Atom> => e,
};

FieldOp: bool = {
    "." => false,
    "?." => true,
};

TrailingClosure: Closure = {
    "move" <captures:("(" <Comma<SpannedIdent>?> ")")?> <c:MoveClosureBody> => Closure {
        params: c.0,
        body: c.1,
        is_move: true,
        captures: captures.map(|c| c.unwrap_or_default()),
    },
    <start:@L> "{" <params:Comma<SpannedIdent>?> "->" <stmts:BlockBody> "}" <end:@R> => Closure {
        params: params.unwrap_or_default(),
        body: Block::from_spanned(Span::new(start, end), stmts),
        is_move: false,
        captures: None,
    },
};

MoveClosureBody: (Vec<SpannedName>, Block) = {
    <start:@L> "{" <params:Comma<SpannedIdent>?> "->" <stmts:BlockBody> "}" <end:@R> => (
        params.unwrap_or_default(),
        Block::from_spanned(Span::new(start, end), stmts),
    ),
    <start:@L> "{" <stmts:BlockBody> "}" <end:@R> => (vec![], Block::from_spanned(Span::new(start, end), stmts)),
};

Atom: Expr = {
    <n:Num> => Expr::Int(n),
    <f:FloatLit> => Expr::Float(f),
    "true" => Expr::Bool(true),
    "false" => Expr::Bool(false),
    <s:StrLit> => Expr::Str(s),
    <start:@L> "[" <elems:Comma<Expr>?> "]" <end:@R> => Expr::ArrayLit {
        elements: elems.unwrap_or_default(),
        span: Span::new(start, end),
    },
    <start:@L> "Vec" "<" <elem:Type> ">" "(" <cap:Expr?> ")" <end:@R> => Expr::VecNew {
        elem,
        cap: cap.map(Box::new),
        span: Span::new(start, end),
    },
    <start:@L> "None" <end:@R> => Expr::None {
        span: Span::new(start, end),
    },
    <start:@L> "Some" "(" <expr:Expr> ")" <end:@R> => Expr::Some {
        expr: Box::new(expr),
        span: Span::new(start, end),
    },
    "move" <id:SpannedIdent> => Expr::Move {
        name: id.name,
        span: id.span,
        id: AstId::DUMMY,
    },
    "promote" <id:SpannedIdent> => Expr::Promote {
        name: id.name,
        span: id.span,
        id: AstId::DUMMY,
    },
    "move" <start:@L> "this" <end:@R> => Expr::Move {
        name: "this".to_string(),
        span: Span::new(start, end),
        id: AstId::DUMMY,
    },
    <start:@L> "this" <end:@R> => Expr::Ident {
        name: "this".to_string(),
        span: Span::new(start, end),
        id: AstId::DUMMY,
    },
    <id:SpannedIdent> => Expr::Ident {
        name: id.name,
        span: id.span,
        id: AstId::DUMMY,
    },
    "(" <e:Expr> ")" => e,
    <e:IfExpr> => e,
    <e:IfValExpr> => e,
    <e:WhenExpr> => e,
};

IfExpr: Expr = {
    "if" "(" <cond:Expr> ")" <then_block:Block> <else_block:ElseClause?> => Expr::If {
        cond: Box::new(cond),
        then_block,
        else_block,
    },
};

IfValExpr: Expr = {
    "if" "val" <binding:SingleConditionalBinding> <then_block:Block> <else_block:ElseClause?> => Expr::IfVal {
        bindings: ConditionalBindings { head: Box::new(binding), tail: Vec::new() }, then_block, else_block,
    },
    "if" "val" "(" <bindings:ConditionalBindings> ")" <then_block:Block> <else_block:ElseClause?> => Expr::IfVal {
        bindings, then_block, else_block,
    },
};

SingleConditionalBinding: ConditionalBinding = {
    <name:SpannedIdent> "=" <start:@L> <value:PresenceOperand> <end:@R> => ConditionalBinding {
        name, value, value_span: Span::new(start, end),
    },
};

ConditionalBinding: ConditionalBinding = {
    <name:SpannedIdent> "=" <start:@L> <value:Expr> <end:@R> => ConditionalBinding {
        name, value, value_span: Span::new(start, end),
    },
};

ConditionalBindings: ConditionalBindings = {
    <bindings:ConditionalBindingList> <_trailing:","?> => bindings,
};

ConditionalBindingList: ConditionalBindings = {
    <head:ConditionalBinding> => ConditionalBindings { head: Box::new(head), tail: Vec::new() },
    <mut bindings:ConditionalBindingList> "," <binding:ConditionalBinding> => {
        bindings.tail.push(binding);
        bindings
    },
};

// `when x { Some(v) => a, None => b }` is `if val v = x { a } else { b }`.
WhenExpr: Expr = {
    "when" <start:@L> <value:PresenceOperand> <end:@R> "{" <_leading:"NL"?>
        "Some" "(" <some_name:SpannedIdent> ")" "=>" <some_block:Block> "NL"
        "None" "=>" <none_block:Block> <_trailing:"NL"?>
    "}" => Expr::IfVal {
        bindings: ConditionalBindings {
            head: Box::new(ConditionalBinding { name: some_name, value, value_span: Span::new(start, end) }),
            tail: Vec::new(),
        },
        then_block: some_block,
        else_block: Some(none_block),
    },
};

PresenceOperand: Expr = {
    <id:SpannedIdent> => Expr::Ident {
        name: id.name,
        span: id.span,
        id: AstId::DUMMY,
    },
    <start:@L> "this" <end:@R> => Expr::Ident {
        name: "this".to_string(),
        span: Span::new(start, end),
        id: AstId::DUMMY,
    },
    <start:@L> <receiver:PresenceOperand> <safe:FieldOp> <name:Ident> <end:@R> => Expr::Field {
        receiver: Box::new(receiver),
        name,
        safe,
        span: Span::new(start, end),
        id: AstId::DUMMY,
    },
    "(" <expr:Expr> ")" => expr,
};

ElseClause: Block = {
    "else" <b:Block> => b,
    // ponytail: desugar else-if to nested else { if }; no ElseIf AST
    <start:@L> "else" <e:IfExpr> <end:@R> => Block::from_spanned(Span::new(start, end), vec![(Stmt::Expr(e), Span::new(start, end))]),
};

SpannedIdent: SpannedName = {
    <start:@L> <name:Ident> <end:@R> => SpannedName::new(name, Span::new(start, end)),
};

Ident: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string(),
};

ArrayTypeLen: u32 = {
    <n:Num> =>? u32::try_from(n).map_err(|_| ParseError::User {
        error: "array length is too large",
    }),
};

Num: i64 = {
    r"[0-9]+" =>? <>.parse().map_err(|_| ParseError::User {
        error: "integer literal out of range for i64",
    }),
};

FloatLit: f64 = {
    r"[0-9]+\.[0-9]+" =>? <>.parse().map_err(|_| ParseError::User {
        error: "invalid float literal",
    }),
};

StrLit: String = {
    r#""([^"\\]|\\.)*""# => unescape_string_literal(<>),
};
