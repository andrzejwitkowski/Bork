<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<language name="Bork" version="1" kateversion="5.0" section="Sources" extensions="*.bork" mimetype="text/x-bork" author="Bork book" license="Apache-2.0">
  <highlighting>
    <list name="keywords">
      <item>fun</item>
      <item>val</item>
      <item>var</item>
      <item>if</item>
      <item>else</item>
      <item>for</item>
      <item>in</item>
      <item>while</item>
      <item>break</item>
      <item>continue</item>
      <item>return</item>
      <item>move</item>
      <item>promote</item>
      <item>true</item>
      <item>false</item>
      <item>Some</item>
      <item>None</item>
    </list>
    <list name="types">
      <item>i8</item>
      <item>i16</item>
      <item>i32</item>
      <item>i64</item>
      <item>u8</item>
      <item>u16</item>
      <item>u32</item>
      <item>u64</item>
      <item>f32</item>
      <item>f64</item>
      <item>bool</item>
      <item>unit</item>
      <item>String</item>
      <item>Int</item>
      <item>Long</item>
      <item>Byte</item>
      <item>Float</item>
      <item>Double</item>
    </list>
    <contexts>
      <context attribute="Normal Text" lineEndContext="#stay" name="Normal">
        <Detect2Chars attribute="Comment" context="Comment" char="/" char1="/"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <RegExpr attribute="DecVal" context="#stay" String="\b[0-9]+(\.[0-9]+)?\b"/>
      </context>
      <context attribute="String" lineEndContext="#pop" name="String">
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context attribute="Comment" lineEndContext="#pop" name="Comment"/>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="DecVal" defStyleNum="dsDecVal"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="single" start="//"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
