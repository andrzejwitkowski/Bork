// quicksort_rec.bork - rekurencyjny quicksort na referencjach (&[i32; 100]).
//
// Ksztalt: median-of-three, Lomuto (pivot na koncu), insertion sort dla zakresow < 13.
// `qsort` woła `partition` i rekurencję wewnątrz `if` (re-borrow `&a` w zagnieżdżonym regionie).
//
// Poprawnosc: 9/9 wzorcow zgodnych z Pythonowym sorted() (patrz harness w QUICKSORT-REC-RAPORT.txt).

fun insert_small(a: &rw [i32; 100], lo: i32, hi: i32) {
    if (hi - lo < 13) {
        var i = lo + 1
        while (i <= hi) {
            val key = a[i]
            var j = i - 1
            while (j >= lo && a[j] > key) {
                a[j + 1] = a[j]
                j = j - 1
            }
            a[j + 1] = key
            i = i + 1
        }
    }
}

fun partition(a: &rw [i32; 100], lo: i32, hi: i32): i32 {
    val mid = lo + (hi - lo) / 2
    if (a[lo] > a[mid]) {
        val t = a[lo]
        a[lo] = a[mid]
        a[mid] = t
    }
    if (a[mid] > a[hi]) {
        val t = a[mid]
        a[mid] = a[hi]
        a[hi] = t
    }
    if (a[lo] > a[mid]) {
        val t = a[lo]
        a[lo] = a[mid]
        a[mid] = t
    }
    val t2 = a[mid]
    a[mid] = a[hi]
    a[hi] = t2
    var i = lo
    var j = lo
    while (j < hi) {
        if (a[j] <= a[hi]) {
            val t = a[i]
            a[i] = a[j]
            a[j] = t
            i = i + 1
        }
        j = j + 1
    }
    val t3 = a[i]
    a[i] = a[hi]
    a[hi] = t3
    return i
}

fun qsort(a: &rw [i32; 100], lo: i32, hi: i32) {
    insert_small(&rw a, lo, hi)
    if (hi - lo >= 13) {
        val p = partition(&rw a, lo, hi)
        qsort(&rw a, lo, p - 1)
        qsort(&rw a, p + 1, hi)
    }
}

