        var a: [i32; 100] = [655, 115, 26, 760, 282, 251, 229, 143, 755, 105, 693, 759, 914, 559, 90, 605, 433, 33, 31, 96, 224, 239, 518, 617, 28, 575, 204, 734, 666, 719, 559, 430, 226, 460, 604, 285, 829, 891, 7, 778, 826, 164, 715, 433, 349, 285, 160, 221, 981, 782, 345, 105, 95, 390, 100, 368, 868, 353, 619, 271, 827, 45, 748, 471, 550, 128, 997, 945, 388, 81, 566, 301, 850, 644, 634, 907, 883, 371, 592, 197, 722, 72, 47, 678, 234, 792, 297, 82, 876, 239, 888, 104, 390, 285, 465, 651, 855, 374, 167, 380]
