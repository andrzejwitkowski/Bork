{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bork",
  "scopeName": "source.bork",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#type-annotation" },
    { "include": "#arrow-type" },
    { "include": "#literals" },
    { "include": "#types-primitive" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bork",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.bork",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bork",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bork",
          "match": "\\b(fun|for|in|return|if|else|move)\\b"
        },
        {
          "name": "keyword.other.bork",
          "match": "\\b(val|var)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.bork",
          "match": "\\b(None|Some|true|false)\\b"
        }
      ]
    },
    "types-primitive": {
      "patterns": [
        {
          "name": "support.type.primitive.bork",
          "match": "\\b(Int|Long|Byte|Float|Double|String|Bool|Unit|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|unit)\\b"
        }
      ]
    },
    "type-name": {
      "patterns": [
        { "include": "#types-primitive" },
        {
          "name": "entity.name.type.bork",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.definition.nullable.bork",
          "match": "\\?"
        }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#type-expression" },
            { "include": "#type-name" },
            {
              "name": "punctuation.separator.parameters.bork",
              "match": ","
            }
          ]
        },
        {
          "match": "->",
          "name": "keyword.operator.type.function.bork"
        },
        { "include": "#type-name" }
      ]
    },
    "type-annotation": {
      "begin": "(:)(\\s*)",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.type.bork" }
      },
      "end": "(?=[,)=\\n]|\\{|\\b(else|in)\\b)",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "arrow-type": {
      "begin": "(->)(\\s*)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.type.function.bork" }
      },
      "end": "(?=[,)=\\n]|\\{|\\b(else|in)\\b)",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bork",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
