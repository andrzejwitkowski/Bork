digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

root[label="Co chcę ustalić?",fillcolor="#d5ebe6"];
a[label="ArenaReport\nregiony i własność"];
b[label="MemoryPlan\ngdzie ma żyć obiekt?"];
c[label="LLVM przed\noptymalizacją\njakie instrukcje\nemitowano?"];
d[label="Graf runtime\nco jest teraz żywe?"];
root->{a b}; a->c[style=invis]; b->d[style=invis]; root->c[constraint=false]; root->d[constraint=false]; {rank=same;a;b} {rank=same;c;d}

}