digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

subgraph cluster_a {label="Gałąź kończy się\nreturn";color="#cbdadb";
a[label="x dostępne"];b[label="move x → return"];
c[label="bez move"];d[label="Dalsze użycie x: OK",fillcolor="#d5ebe6"];
a->{b c};c->d;}
subgraph cluster_b {label="Obie gałęzie docierają\ndalej";color="#cbdadb";
e[label="x dostępne"];f[label="move x"];g[label="bez move"];
h[label="x być może\nprzeniesione\nużycie odrzucone",color="#b15f36"];
e->{f g};f->h;g->h;}

}