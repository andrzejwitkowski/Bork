digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

a[label="Profil Cargo\ndev / release\nkompilator Borka"];
b[label="bork build\nIR: default<O3> +\npasses\ntarget: Default"];
c[label="bork build -g\nIR: default<O0>\ntarget: None"];
r[label="Runtime zwykły\nrustc opt-level=2"];
d[label="Runtime debug\nopt-level=0,\ndebuginfo=2"];
a->b[style=dashed,label="uruchamia"];a->c[style=dashed];b->r;c->d;

}