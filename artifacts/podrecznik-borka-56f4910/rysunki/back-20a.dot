digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];


open[label="didOpen / didChange"];
text[label="Tekst + epoka"];
check[label="check → gate"];
analysis[label="Analysis\naktualna epoka?"];
out[label="Diagnostyki\nhover / dump"];
close[label="didClose → usuń stan",color="#b15f36"];
open->text->check->analysis->out;close->analysis[style=dashed,label="unieważnia"];

{rank=same;open;text;check} {rank=same;analysis;out}
}