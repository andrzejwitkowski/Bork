digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

subgraph cluster_ast {label="AST: 1 + 2 * 3";color="#cbdadb";
a[label="Add"]; b[label="1"];c[label="Mul"];d[label="2"];e[label="3"];
a->{b c};c->{d e};}
subgraph cluster_hir {label="HIR: inne NodeId";color="#cbdadb";
h[label="Binary Add : i32"];i[label="Int 1 : i32"];j[label="Binary Mul : i32"];
h->{i j};}
idx[label="Span → AstId\nindeks AST"];
a->h[style=dashed,label="lowering"];idx->a[style=dashed];

}