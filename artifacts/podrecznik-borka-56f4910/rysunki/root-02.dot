digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.25", ranksep="0.35", fontname="DejaVu Sans", fontsize=11];
node [shape=box, style="rounded,filled", fillcolor="#edf4f4", color="#087e83", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
edge [color="#46636d", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

src[label="Tekst źródłowy"]; ast[label="AST + prelude"]; tc[label="Typeck"];
hir[label="Typowany HIR"]; sema[label="Sema na AST\n+ typy i member\nresolutions"];
ok[label="Brak diagnostyk?",shape=diamond]; mem[label="Hoist → escape\n→ MemoryPlan → stamp"];
src->ast->tc; tc->hir; ast->sema[style=dashed]; tc->sema;
hir->ok; sema->ok; ok->mem[label="tak"];
{rank=same;hir;sema}

}